    <string name="how_it_works_title">How it works</string>
    <string name="how_it_works_body">When battery drops to your threshold and the phone is not charging, a loud alarm plays immediately, then repeats every 60 seconds. At 2%% or below, repeats every 20 seconds. Charging stops the alarm instantly.</string>

    <string name="settings_background_title">Background monitoring</string>
    <string name="settings_background_body">With the alarm enabled, the app runs a foreground service so battery changes are detected overnight. This uses a low-priority ongoing notification while monitoring, and a high-priority notification during a low-battery alert.</string>

    <string name="settings_escalation_title">Repeat schedule</string>
    <string name="settings_escalation_body">Warning (above %2$d%% but at/below threshold): every %1$d seconds.\nCritical (%2$d%% or below): every %3$d seconds.\nCharging: alarm stops immediately.</string>

    <string name="settings_permissions_title">Permissions</string>
    <string name="settings_permissions_body">Notifications are required for alerts and the monitoring service. No account or network access is needed.</string>

